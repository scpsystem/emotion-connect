# Salin fail ini kepada .env.local dan isi nilai daripada Firebase Console.
# AMARAN: nilai VITE_ akan terdedah dalam binaan frontend. Ia bukan rahsia;
# keselamatan data dijamin oleh Firestore Security Rules, bukan oleh kunci ini.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Nama repo GitHub anda (untuk GitHub Pages)
VITE_BASE=/emotion-connect/
